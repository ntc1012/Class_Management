APP_URL=http://127.0.0.1:3000
# Local SQLite is for development only. Production requires PostgreSQL and S3.
SQLITE_PATH=./data/classflow.sqlite
DATABASE_URL=
PAYMENT_MODE=demo
# Required in production: 64 hexadecimal characters (32 random bytes).
ENCRYPTION_KEY=
CRON_SECRET=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_FILE_MB=10
TEACHER_STORAGE_MB=500
