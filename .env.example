APP_URL=https://classmanagement-omega.vercel.app
# Vercel runtime requires PostgreSQL and private S3 storage.
DATABASE_URL=
ADMIN_SETUP_TOKEN=
PAYMENT_MODE=demo
# Required in production: 64 hexadecimal characters (32 random bytes).
ENCRYPTION_KEY=
CRON_SECRET=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_FILE_MB=10
TEACHER_STORAGE_MB=500
